import requests

# Basic add request (no authentication required when API_KEY env var is unset).
resp = requests.post("http://localhost:8080/add", json={"x": 5, "y": 3})
print(resp.json())  # {'result': 8}

# If the server is started with API_KEY set, include the header:
# resp = requests.post(
#     "http://localhost:8080/add",
#     json={"x": 5, "y": 3},
#     headers={"X-API-Key": "mysecret"},
# )

# AI echo endpoint
resp_echo = requests.post("http://localhost:8080/ai/echo", json={"prompt": "hello"})
print(resp_echo.json())

# Metrics endpoint (GET)
resp_metrics = requests.get("http://localhost:8080/metrics")
print(resp_metrics.json())
